# `npm version` in this repo only edits files: it bumps package.json and both
# version fields in package-lock.json, and does NOT create a git commit or tag.
# Release tags (unprefixed, e.g. 3.3.1) are created by the main-deploy workflow,
# not by npm. Use `npm version <version>` (or patch/minor/major) instead of
# editing package.json by hand so the lockfile stays in sync; the Version Check
# workflow fails PRs where they differ.
# Pass --git-tag-version to override. Never put registry tokens in this file.
git-tag-version=false
